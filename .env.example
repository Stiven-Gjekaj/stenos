# Bot token from the Discord developer portal. Required.
DISCORD_TOKEN=

# Optional guild id. When set, slash commands register to that guild only,
# which propagates immediately instead of taking up to an hour globally.
GUILD_ID=

# Transcription backend: mlx, faster-whisper, or auto.
# auto selects mlx on Apple Silicon and faster-whisper elsewhere.
WHISPER_BACKEND=mlx

# Whisper model size: tiny, base, small, medium, large-v3.
WHISPER_MODEL=small

# Spoken language as an ISO 639-1 code, or auto to detect per segment.
LANGUAGE=auto

# Seconds of silence from a speaker that closes the current segment.
# Discord transmits only while a participant speaks, so packet gaps
# delimit utterances without a separate voice activity detector.
SEGMENT_GAP=0.4

# Segments shorter than this many seconds are discarded before
# transcription. Whisper emits confident phantom lines on near-silence.
MIN_SEGMENT=0.3

# Retain buffered audio after transcription instead of discarding it.
KEEP_AUDIO=false

# Full path to libopus, for installations the standard search does not find.
# The Homebrew prefixes on macOS and the usual system paths on Linux are
# already searched, so this is rarely required.
# OPUS_LIBRARY_PATH=
