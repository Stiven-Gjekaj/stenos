# Bot token from the Discord developer portal. Required.
DISCORD_TOKEN=

# Optional guild id. When set, slash commands register to that guild only,
# which propagates immediately instead of taking up to an hour globally.
GUILD_ID=

# Transcription backend: mlx, faster-whisper, or auto.
# auto selects mlx on Apple Silicon and faster-whisper elsewhere.
WHISPER_BACKEND=mlx

# Whisper model size: tiny, base, small, medium, large-v3.
WHISPER_MODEL=small

# Spoken language as an ISO 639-1 code, or auto to detect per segment.
LANGUAGE=auto

# Seconds of silence from a speaker that closes the current segment.
# Discord transmits only while a participant speaks, so packet gaps
# delimit utterances without a separate voice activity detector.
SEGMENT_GAP=0.4

# Segments shorter than this many seconds are discarded before
# transcription. Whisper emits confident phantom lines on near-silence.
MIN_SEGMENT=0.3

# Seconds after which a segment closes for length rather than for silence.
# Bounds what one speaker who never pauses holds in memory, and matches the
# window a Whisper encoder reads, so a long turn gets a timestamp per part.
MAX_SEGMENT=30

# Megabytes of buffered audio at which a recording stops holding the call in
# memory and continues it on disk instead. About nine hours of speech. Lower it
# on a small host. Set to 0 to keep everything resident however long the call
# runs, on a host with the memory for it.
MAX_BUFFER_MB=1024

# Megabytes of audio, on disk and in memory together, at which a recording
# stops itself and transcribes what it captured. This is the limit that ends a
# call; MAX_BUFFER_MB only decides where the audio lives. Set to 0 for no
# limit, and watch the disk yourself.
MAX_DISK_MB=4096

# Seconds a recording waits for a lost voice connection to come back before it
# ends itself and transcribes what it captured. Has to outlast a reconnect,
# which reads as disconnected while it runs. Set to 0 to wait forever.
DISCONNECT_GRACE=60

# Where transcripts and their sidecars are written. Relative to the working
# directory, and a leading ~ is expanded.
OUTPUT_DIR=transcripts

# Write the recorded audio to OUTPUT_DIR alongside the transcript, one WAV per
# participant on the call's timeline. About 115 MB per participant per hour.
KEEP_AUDIO=false

# Full path to libopus, for installations the standard search does not find.
# The Homebrew prefixes on macOS and the usual system paths on Linux are
# already searched, so this is rarely required.
# OPUS_LIBRARY_PATH=
